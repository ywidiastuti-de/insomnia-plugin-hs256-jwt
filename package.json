  "description": "Insomnia template tag that generates an HS256 JWT signed with a shared secret",
  "author": "Yuni Widiastuti <yuni.widiastuti@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ywidiastuti-de/insomnia-plugin-hs256-jwt.git"
  },
