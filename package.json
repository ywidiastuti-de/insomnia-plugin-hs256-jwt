  "bugs": {
    "url": "https://github.com/ywidiastuti-de/insomnia-plugin-hs256-jwt/issues"
  },
  "main": "main.js",
  "keywords": [
    "insomnia",
    "insomnia-plugin",
    "jwt",
    "hs256",
